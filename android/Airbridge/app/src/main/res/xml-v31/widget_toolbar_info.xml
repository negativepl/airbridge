<?xml version="1.0" encoding="utf-8"?>
<!-- Quick actions as a row, 4x1 (Google canonical Toolbar sizes). Android 12+. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_toolbar_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="256dp"
    android:minHeight="48dp"
    android:minResizeWidth="48dp"
    android:minResizeHeight="48dp"
    android:maxResizeWidth="624dp"
    android:maxResizeHeight="422dp"
    android:targetCellWidth="4"
