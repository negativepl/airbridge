<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Airbridge" parent="Theme.Material3.DayNight.NoActionBar"></style>

    <!-- System splash (core-splashscreen): held on screen by MainActivity until
         the Mac connection and its info are in, so the home screen composes in
         its final state instead of sections popping in one by one. -->
    <style name="Theme.Airbridge.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Airbridge</item>
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
    </style>

    <!-- Full-screen theme for ShareReceiverActivity. Uses DayNight so the
         pre-Compose window background automatically matches the system
         dark/light mode, and share_bg is set to the exact color that
         AirbridgeTheme renders as colorScheme.surface — so the launch
         splash phase transitions into the Compose content with zero
         visible flash. Also forces the status / navigation bar to the
         same color for an edge-to-edge clean look. -->
    <style name="Theme.Airbridge.Share" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/share_bg</item>
        <item name="android:statusBarColor">@color/share_bg</item>
        <item name="android:navigationBarColor">@color/share_bg</item>
    </style>

    <!-- Invisible host for activities that only launch something else or show
         a system dialog (CaptureActivity, GalleryDeleteActivity): the window
         itself has to disappear visually. -->
    <style name="Theme.Airbridge.TransparentDialog" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Widget buttons: an invisible window that should not animate at all, so
         the launcher's own widget transition is the only motion. -->
    <style name="Theme.Airbridge.WidgetAction" parent="Theme.Airbridge.TransparentDialog">
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Widget settings: the real wallpaper behind the window, so the preview of
         the widget (and its transparency) shows on what it will sit on. -->
    <style name="Theme.Airbridge.WidgetSettings" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
